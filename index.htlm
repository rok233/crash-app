<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>SLOT HOUSE - Casino</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #0b0e14;
            --card-bg: #131823;
            --text-color: #e6edf3;
            --text-muted: #8b949e;
            --accent: #2ecc71;
            --danger: #e74c3c;
            --border: #21262d;
            --yellow: #f1c40f;
            --blue: #3498db;
            --purple: #9b59b6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); height: 100vh; display: flex; flex-direction: column; overflow: hidden; font-size: 14px; }

        /* Шапка */
        header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background-color: var(--card-bg); border-bottom: 1px solid var(--border); }
        .logo-text { font-weight: 900; font-size: 16px; color: #fff; letter-spacing: 0.5px; }
        .stars-balance { background: rgba(241, 196, 15, 0.15); color: var(--yellow); padding: 6px 14px; border-radius: 20px; font-weight: bold; display: flex; align-items: center; gap: 6px; cursor: pointer; }

        /* Контент вкладок */
        .main-content { display: none; flex: 1; flex-direction: column; overflow-y: auto; padding-bottom: 20px; }
        .main-content.active { display: flex; }

        /* Лобби / Игры */
        .lobby-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 16px; }
        .game-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 16px; text-align: center; cursor: pointer; transition: transform 0.1s; }
        .game-card:active { transform: scale(0.96); border-color: var(--blue); }
        .game-icon { font-size: 32px; margin-bottom: 8px; }
        .game-title { font-weight: bold; font-size: 14px; color: #fff; }
        .game-desc { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

        /* Игровое поле Краша */
        .crash-screen { flex: 1; display: flex; flex-direction: column; height: 100%; }
        .history { display: flex; gap: 8px; padding: 10px 16px; overflow-x: auto; background: rgba(0,0,0,0.3); border-bottom: 1px solid var(--border); }
        .hist-item { padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; }
        .hist-green { background: rgba(46, 204, 113, 0.15); color: #2ecc71; }
        .hist-red { background: rgba(231, 76, 60, 0.15); color: #e74c3c; }

        .game-area { flex: 1; position: relative; background: radial-gradient(circle at center, #1a2332 0%, #0b0e14 75%); display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .multiplier { font-size: 52px; font-weight: 900; color: #fff; text-shadow: 0 0 20px rgba(52,152,219,0.5); }
        .multiplier.crashed { color: var(--danger); }
        .back-lobby { background: none; border: none; color: var(--blue); font-size: 14px; padding: 10px 16px; cursor: pointer; text-align: left; font-weight: bold; }

        /* Панель ставок */
        .bet-panel { background-color: var(--card-bg); border-top: 1px solid var(--border); padding: 16px; }
        .bet-amount { font-size: 24px; font-weight: bold; text-align: center; color: #fff; margin-bottom: 10px; }
        .bet-input-group { display: flex; gap: 8px; margin-bottom: 12px; }
        .bet-btn-small { flex: 1; background: #21262d; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; }
        .main-action-btn { width: 100%; padding: 15px; border-radius: 12px; border: none; font-size: 16px; font-weight: bold; cursor: pointer; }
        .btn-bet { background-color: var(--accent); color: #000; }
        .btn-cashout { background-color: var(--danger); color: #fff; }

        /* Профиль и карточки */
        .profile-container { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
        .profile-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
        .input-field { width: 100%; background: #21262d; border: 1px solid var(--border); border-radius: 10px; padding: 12px; color: #fff; font-size: 15px; outline: none; margin-top: 8px; margin-bottom: 12px; }
        .btn-action { width: 100%; padding: 14px; border-radius: 10px; border: none; font-weight: bold; cursor: pointer; }

        /* Админка */
        .admin-log { background: #000; color: #0f0; padding: 10px; border-radius: 8px; font-family: monospace; font-size: 11px; max-height: 150px; overflow-y: auto; margin-top: 8px; }
        .admin-row { display: flex; gap: 8px; margin-top: 8px; }

        /* Нижнее меню */
        nav { display: flex; background-color: var(--card-bg); border-top: 1px solid var(--border); }
        .nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px; color: var(--text-muted); background: none; border: none; cursor: pointer; gap: 4px; }
        .nav-item.active { color: var(--accent); }
        .nav-icon { font-size: 18px; }
        .nav-label { font-size: 10px; font-weight: 500; }

        /* Уведомления */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: none; justify-content: center; align-items: flex-end; z-index: 100; backdrop-filter: blur(4px); }
        .modal-content { background: var(--card-bg); width: 100%; border-radius: 20px 20px 0 0; padding: 20px; border-top: 1px solid var(--border); max-height: 85vh; overflow-y: auto; }
    </style>
</head>
<body>
    <header>
        <div class="logo-text">⚡ SLOT HOUSE 1WIN</div>
        <div class="stars-balance" onclick="switchTab('profile', document.querySelectorAll('.nav-item')[1])">⭐ <span id="balance">1000</span></div>
    </header>

    <!-- Вкладка 1: ЛОББИ И ИГРЫ -->
    <div id="tab-lobby" class="main-content active">
        <div class="lobby-grid">
            <div class="game-card" onclick="openGame('crash')">
                <div class="game-icon">🚀</div>
                <div class="game-title">Краш Ракета</div>
                <div class="game-desc">Успей забрать х</div>
            </div>
            <div class="game-card" onclick="openGame('blackjack')">
                <div class="game-icon">🃏</div>
                <div class="game-title">Блэкджек</div>
                <div class="game-desc">Классика 21</div>
            </div>
            <div class="game-card" onclick="openGame('roulette')">
                <div class="game-icon">🎯</div>
                <div class="game-title">Рулетка</div>
                <div class="game-desc">Красное / Черное</div>
            </div>
            <div class="game-card" onclick="openGame('poker')">
                <div class="game-icon">🎲</div>
                <div class="game-title">Покер быстрый</div>
                <div class="game-desc">Собери комбинацию</div>
            </div>
        </div>
    </div>

    <!-- ЭКРАН САМОЙ ИГРЫ (КРАШ) -->
    <div id="tab-game" class="main-content">
        <button class="back-lobby" onclick="switchTab('lobby', document.querySelectorAll('.nav-item')[0])">← Назад в лобби</button>
        <div class="crash-screen">
            <div class="history" id="historyList"></div>
            <div class="game-area">
                <div class="multiplier" id="multText">1.00x</div>
            </div>
            <div class="bet-panel">
                <div class="bet-amount">⭐ <span id="currentBetDisplay">10</span></div>
                <div class="bet-input-group">
                    <button class="bet-btn-small" onclick="adjustBet(-10)">-10</button>
                    <button class="bet-btn-small" onclick="adjustBet(50)">+50</button>
                    <button class="bet-btn-small" onclick="adjustBet('MAX')">MAX</button>
                </div>
                <button id="actionBtn" class="main-action-btn btn-bet" onclick="handleAction()">Сделать ставку</button>
            </div>
        </div>
    </div>

    <!-- Вкладка 2: ПРОФИЛЬ (Пополнение и Вывод) -->
    <div id="tab-profile" class="main-content profile-container">
        <h2 style="color:#fff;">Личный кабинет (west)</h2>
        <div class="profile-card">
            <p style="color:var(--text-muted); font-size:12px;">Основной баланс:</p>
            <h1 style="color:var(--yellow); margin-top:4px;">⭐ <span id="profileBalance">1000</span></h1>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px; margin-bottom:5px;">💳 Пополнение (Карта / СБП / Stars)</h3>
            <input type="number" id="depositInput" class="input-field" value="200" min="50">
            <button class="btn-action" style="background:var(--accent); color:#000;" onclick="makeDeposit()">Пополнить баланс</button>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px; margin-bottom:5px;">💸 Вывод средств на карту</h3>
            <input type="text" id="cardNumber" class="input-field" placeholder="Номер карты (16 цифр)">
            <input type="number" id="withdrawInput" class="input-field" value="100" min="100">
            <button class="btn-action" style="background:var(--blue); color:#fff;" onclick="makeWithdraw()">Запросить вывод</button>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px; margin-bottom:5px;">⚙️ Административная панель</h3>
            <button class="btn-action" style="background:#e67e22; color:#fff;" onclick="openAdminPanel()">Вход в Админку (Пароль: 2012)</button>
        </div>
    </div>

    <!-- Вкладка 3: АДМИН-ПАНЕЛЬ (Защищена паролем 2012) -->
    <div id="tab-admin" class="main-content profile-container" style="display:none;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h2 style="color:#fff;">🔐 Админ-панель</h2>
            <button onclick="switchTab('lobby', document.querySelectorAll('.nav-item')[0])" style="background:none; border:none; color:var(--blue); font-weight:bold; cursor:pointer;">Закрыть</button>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px;">👥 Управление игроком (west)</h3>
            <p style="color:var(--text-muted); font-size:11px; margin-top:4px;">Текущий баланс: ⭐ <span id="adminUserBal">1000</span></p>
            <div class="admin-row">
                <input type="number" id="adminNewBal" class="input-field" placeholder="Новый баланс" style="margin:0;">
                <button class="btn-action" style="background:var(--yellow); color:#000; width:120px;" onclick="adminSetBalance()">Изменить</button>
            </div>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px;">📋 Логи и действия игроков</h3>
            <div class="admin-log" id="adminLogs">
                [17:00] Игрок west зашел в систему.<br>
                [17:01] Создан сеанс игры Crash.<br>
            </div>
        </div>
    </div>

    <nav>
        <button class="nav-item active" onclick="switchTab('lobby', this)">
            <span class="nav-icon">🏠</span>
            <span class="nav-label">Лобби</span>
        </button>
        <button class="nav-item" onclick="switchTab('profile', this)">
            <span class="nav-icon">👤</span>
            <span class="nav-label">Профиль</span>
        </button>
    </nav>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.headerColor = '#131822';

        let balance = 1000;
        let currentBet = 10;
        let gameState = 'waiting';
        let multiplier = 1.00;
        let crashPoint = 1.00;
        let gameTimer = null;

        const balanceDisplay = document.getElementById('balance');
        const profileBalance = document.getElementById('profileBalance');
        const adminUserBal = document.getElementById('adminUserBal');
        const currentBetDisplay = document.getElementById('currentBetDisplay');
        const multText = document.getElementById('multText');
        const actionBtn = document.getElementById('actionBtn');
        const historyList = document.getElementById('historyList');
        const adminLogs = document.getElementById('adminLogs');

        function updateUI() {
            balanceDisplay.innerText = balance;
            profileBalance.innerText = balance;
            adminUserBal.innerText = balance;
            currentBetDisplay.innerText = currentBet;
        }

        function addLog(text) {
            let time = new Date().toLocaleTimeString();
            adminLogs.innerHTML += `[${time}] ${text}<br>`;
            adminLogs.scrollTop = adminLogs.scrollHeight;
        }

        function switchTab(tabName, btn) {
            document.querySelectorAll('.main-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            
            if (tabName === 'game') {
                document.getElementById('tab-game').classList.add('active');
            } else if (tabName === 'admin') {
                document.getElementById('tab-admin').classList.add('active');
            } else {
                document.getElementById('tab-' + tabName).classList.add('active');
                if(btn) btn.classList.add('active');
            }
        }

        function openGame(type) {
            if (type === 'crash') {
                switchTab('game');
            } else {
                alert("Игра в разработке, скоро запустим! Запускай Краш ракета 🚀");
                switchTab('game');
            }
        }

        function adjustBet(amount) {
            if (gameState !== 'waiting') return;
            if (amount === 'MAX') {
                currentBet = balance;
            } else {
                currentBet = Math.max(10, currentBet + amount);
                if (currentBet > balance) currentBet = balance;
            }
            updateUI();
        }

        function handleAction() {
            if (gameState === 'waiting') {
                if (currentBet > balance) {
                    alert('Недостаточно средств!');
                    switchTab('profile', document.querySelectorAll('.nav-item')[1]);
                    return;
                }
                balance -= currentBet;
                updateUI();
                addLog(`Игрок поставил ⭐ ${currentBet} в Краш.`);
                startFlight();
            } else if (gameState === 'playing') {
                cashOut();
            }
        }

        function startFlight() {
            gameState = 'playing';
            multiplier = 1.00;
            multText.classList.remove('crashed');
            multText.innerText = '1.00x';
            actionBtn.innerText = 'ЗАБРАТЬ ⭐ ' + Math.floor(currentBet * multiplier);
            actionBtn.className = 'main-action-btn btn-cashout';

            crashPoint = (Math.random() * Math.random() * 4 + 1.1).toFixed(2);

            gameTimer = setInterval(() => {
                multiplier += 0.01 + (multiplier * 0.005);
                multText.innerText = multiplier.toFixed(2) + 'x';
                let winSum = Math.floor(currentBet * multiplier);
                actionBtn.innerText = 'ЗАБРАТЬ ⭐ ' + winSum;

                if (multiplier >= crashPoint) {
                    crashGame();
                }
            }, 100);
        }

        function cashOut() {
            if (gameState !== 'playing') return;
            clearInterval(gameTimer);
            let win = Math.floor(currentBet * multiplier);
            balance += win;
            updateUI();

            gameState = 'crashed';
            multText.innerText = multiplier.toFixed(2) + 'x';
            actionBtn.innerText = `Выиграно ⭐ ${win}`;
            actionBtn.className = 'main-action-btn btn-bet';
            actionBtn.disabled = true;

            addLog(`Игрок успешно забрал ⭐ ${win} на коэффициенте ${multiplier.toFixed(2)}x`);
            addToHistory(multiplier.toFixed(2));
            setTimeout(resetGame, 3000);
        }

        function crashGame() {
            clearInterval(gameTimer);
            gameState = 'crashed';
            multText.classList.add('crashed');
            multText.innerText = crashPoint + 'x';
            actionBtn.innerText = 'Краш! Ставка сгорела';
            actionBtn.className = 'main-action-btn btn-bet';
            actionBtn.disabled = true;

            addLog(`Раунд закрашился на ${crashPoint}x. Ставка проиграна.`);
            addToHistory(crashPoint);
            setTimeout(resetGame, 3000);
        }

        function resetGame() {
            gameState = 'waiting';
            multText.classList.remove('crashed');
            multText.innerText = '1.00x';
            actionBtn.innerText = 'Сделать ставку';
            actionBtn.className = 'main-action-btn btn-bet';
            actionBtn.disabled = false;
        }

        function addToHistory(val) {
            const item = document.createElement('div');
            item.className = 'hist-item ' + (val < 2 ? 'hist-red' : 'hist-green');
            item.innerText = val + 'x';
            historyList.prepend(item);
            if (historyList.children.length > 8) historyList.lastChild.remove();
        }

        function makeDeposit() {
            let sum = parseInt(document.getElementById('depositInput').value) || 0;
            if (sum <= 0) { alert('Введите сумму'); return; }
            balance += sum;
            updateUI();
            addLog(`Успешное пополнение баланса на ⭐ ${sum}`);
            alert(`Баланс пополнен на ${sum} ⭐`);
        }

        function makeWithdraw() {
            let card = document.getElementById('cardNumber').value;
            let sum = parseInt(document.getElementById('withdrawInput').value) || 0;
            if (!card || card.length < 15) { alert('Введите номер карты'); return; }
            if (sum <= 0 || sum > balance) { alert('Неверная сумма для вывода'); return; }
            
            balance -= sum;
            updateUI();
            addLog(`Запрос на вывод ⭐ ${sum} на карту ${card.slice(-4)}`);
            alert(`Заявка на вывод ${sum} ⭐ принята в обработку!`);
        }

        function openAdminPanel() {
            let pass = prompt("Введите пароль администратора:");
            if (pass === "2012") {
                switchTab('admin');
                addLog("Администратор вошел в панель управления.");
            } else if (pass !== null) {
                alert("Неверный пароль!");
                addLog("Неудачная попытка входа в админку.");
            }
        }

        function adminSetBalance() {
            let newBal = parseInt(document.getElementById('adminNewBal').value);
            if (isNaN(newBal)) { alert('Введите число'); return; }
            balance = newBal;
            updateUI();
            addLog(`Админ изменил баланс пользователя на ⭐ ${balance}`);
            alert(`Баланс игрока успешно изменен на ${balance} ⭐`);
        }

        updateUI();
        addToHistory(1.74); addToHistory(2.10);
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>SLOT HOUSE - Casino</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #0b0e14;
            --card-bg: #131823;
            --text-color: #e6edf3;
            --text-muted: #8b949e;
            --accent: #2ecc71;
            --danger: #e74c3c;
            --border: #21262d;
            --yellow: #f1c40f;
            --blue: #3498db;
            --purple: #9b59b6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); height: 100vh; display: flex; flex-direction: column; overflow: hidden; font-size: 14px; }

        /* Шапка */
        header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background-color: var(--card-bg); border-bottom: 1px solid var(--border); }
        .logo-text { font-weight: 900; font-size: 16px; color: #fff; letter-spacing: 0.5px; }
        .stars-balance { background: rgba(241, 196, 15, 0.15); color: var(--yellow); padding: 6px 14px; border-radius: 20px; font-weight: bold; display: flex; align-items: center; gap: 6px; cursor: pointer; }

        /* Контент вкладок */
        .main-content { display: none; flex: 1; flex-direction: column; overflow-y: auto; padding-bottom: 20px; }
        .main-content.active { display: flex; }

        /* Лобби / Игры */
        .lobby-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 16px; }
        .game-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 16px; text-align: center; cursor: pointer; transition: transform 0.1s; }
        .game-card:active { transform: scale(0.96); border-color: var(--blue); }
        .game-icon { font-size: 32px; margin-bottom: 8px; }
        .game-title { font-weight: bold; font-size: 14px; color: #fff; }
        .game-desc { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

        /* Игровое поле Краша */
        .crash-screen { flex: 1; display: flex; flex-direction: column; height: 100%; }
        .history { display: flex; gap: 8px; padding: 10px 16px; overflow-x: auto; background: rgba(0,0,0,0.3); border-bottom: 1px solid var(--border); }
        .hist-item { padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; }
        .hist-green { background: rgba(46, 204, 113, 0.15); color: #2ecc71; }
        .hist-red { background: rgba(231, 76, 60, 0.15); color: #e74c3c; }

        .game-area { flex: 1; position: relative; background: radial-gradient(circle at center, #1a2332 0%, #0b0e14 75%); display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .multiplier { font-size: 52px; font-weight: 900; color: #fff; text-shadow: 0 0 20px rgba(52,152,219,0.5); }
        .multiplier.crashed { color: var(--danger); }
        .back-lobby { background: none; border: none; color: var(--blue); font-size: 14px; padding: 10px 16px; cursor: pointer; text-align: left; font-weight: bold; }

        /* Панель ставок */
        .bet-panel { background-color: var(--card-bg); border-top: 1px solid var(--border); padding: 16px; }
        .bet-amount { font-size: 24px; font-weight: bold; text-align: center; color: #fff; margin-bottom: 10px; }
        .bet-input-group { display: flex; gap: 8px; margin-bottom: 12px; }
        .bet-btn-small { flex: 1; background: #21262d; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; }
        .main-action-btn { width: 100%; padding: 15px; border-radius: 12px; border: none; font-size: 16px; font-weight: bold; cursor: pointer; }
        .btn-bet { background-color: var(--accent); color: #000; }
        .btn-cashout { background-color: var(--danger); color: #fff; }

        /* Профиль и карточки */
        .profile-container { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
        .profile-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
        .input-field { width: 100%; background: #21262d; border: 1px solid var(--border); border-radius: 10px; padding: 12px; color: #fff; font-size: 15px; outline: none; margin-top: 8px; margin-bottom: 12px; }
        .btn-action { width: 100%; padding: 14px; border-radius: 10px; border: none; font-weight: bold; cursor: pointer; }

        /* Админка */
        .admin-log { background: #000; color: #0f0; padding: 10px; border-radius: 8px; font-family: monospace; font-size: 11px; max-height: 150px; overflow-y: auto; margin-top: 8px; }
        .admin-row { display: flex; gap: 8px; margin-top: 8px; }

        /* Нижнее меню */
        nav { display: flex; background-color: var(--card-bg); border-top: 1px solid var(--border); }
        .nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px; color: var(--text-muted); background: none; border: none; cursor: pointer; gap: 4px; }
        .nav-item.active { color: var(--accent); }
        .nav-icon { font-size: 18px; }
        .nav-label { font-size: 10px; font-weight: 500; }

        /* Уведомления */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: none; justify-content: center; align-items: flex-end; z-index: 100; backdrop-filter: blur(4px); }
        .modal-content { background: var(--card-bg); width: 100%; border-radius: 20px 20px 0 0; padding: 20px; border-top: 1px solid var(--border); max-height: 85vh; overflow-y: auto; }
    </style>
</head>
<body>
    <header>
        <div class="logo-text">⚡ SLOT HOUSE 1WIN</div>
        <div class="stars-balance" onclick="switchTab('profile', document.querySelectorAll('.nav-item')[1])">⭐ <span id="balance">1000</span></div>
    </header>

    <!-- Вкладка 1: ЛОББИ И ИГРЫ -->
    <div id="tab-lobby" class="main-content active">
        <div class="lobby-grid">
            <div class="game-card" onclick="openGame('crash')">
                <div class="game-icon">🚀</div>
                <div class="game-title">Краш Ракета</div>
                <div class="game-desc">Успей забрать х</div>
            </div>
            <div class="game-card" onclick="openGame('blackjack')">
                <div class="game-icon">🃏</div>
                <div class="game-title">Блэкджек</div>
                <div class="game-desc">Классика 21</div>
            </div>
            <div class="game-card" onclick="openGame('roulette')">
                <div class="game-icon">🎯</div>
                <div class="game-title">Рулетка</div>
                <div class="game-desc">Красное / Черное</div>
            </div>
            <div class="game-card" onclick="openGame('poker')">
                <div class="game-icon">🎲</div>
                <div class="game-title">Покер быстрый</div>
                <div class="game-desc">Собери комбинацию</div>
            </div>
        </div>
    </div>

    <!-- ЭКРАН САМОЙ ИГРЫ (КРАШ) -->
    <div id="tab-game" class="main-content">
        <button class="back-lobby" onclick="switchTab('lobby', document.querySelectorAll('.nav-item')[0])">← Назад в лобби</button>
        <div class="crash-screen">
            <div class="history" id="historyList"></div>
            <div class="game-area">
                <div class="multiplier" id="multText">1.00x</div>
            </div>
            <div class="bet-panel">
                <div class="bet-amount">⭐ <span id="currentBetDisplay">10</span></div>
                <div class="bet-input-group">
                    <button class="bet-btn-small" onclick="adjustBet(-10)">-10</button>
                    <button class="bet-btn-small" onclick="adjustBet(50)">+50</button>
                    <button class="bet-btn-small" onclick="adjustBet('MAX')">MAX</button>
                </div>
                <button id="actionBtn" class="main-action-btn btn-bet" onclick="handleAction()">Сделать ставку</button>
            </div>
        </div>
    </div>

    <!-- Вкладка 2: ПРОФИЛЬ (Пополнение и Вывод) -->
    <div id="tab-profile" class="main-content profile-container">
        <h2 style="color:#fff;">Личный кабинет (west)</h2>
        <div class="profile-card">
            <p style="color:var(--text-muted); font-size:12px;">Основной баланс:</p>
            <h1 style="color:var(--yellow); margin-top:4px;">⭐ <span id="profileBalance">1000</span></h1>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px; margin-bottom:5px;">💳 Пополнение (Карта / СБП / Stars)</h3>
            <input type="number" id="depositInput" class="input-field" value="200" min="50">
            <button class="btn-action" style="background:var(--accent); color:#000;" onclick="makeDeposit()">Пополнить баланс</button>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px; margin-bottom:5px;">💸 Вывод средств на карту</h3>
            <input type="text" id="cardNumber" class="input-field" placeholder="Номер карты (16 цифр)">
            <input type="number" id="withdrawInput" class="input-field" value="100" min="100">
            <button class="btn-action" style="background:var(--blue); color:#fff;" onclick="makeWithdraw()">Запросить вывод</button>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px; margin-bottom:5px;">⚙️ Административная панель</h3>
            <button class="btn-action" style="background:#e67e22; color:#fff;" onclick="openAdminPanel()">Вход в Админку (Пароль: 2012)</button>
        </div>
    </div>

    <!-- Вкладка 3: АДМИН-ПАНЕЛЬ (Защищена паролем 2012) -->
    <div id="tab-admin" class="main-content profile-container" style="display:none;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h2 style="color:#fff;">🔐 Админ-панель</h2>
            <button onclick="switchTab('lobby', document.querySelectorAll('.nav-item')[0])" style="background:none; border:none; color:var(--blue); font-weight:bold; cursor:pointer;">Закрыть</button>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px;">👥 Управление игроком (west)</h3>
            <p style="color:var(--text-muted); font-size:11px; margin-top:4px;">Текущий баланс: ⭐ <span id="adminUserBal">1000</span></p>
            <div class="admin-row">
                <input type="number" id="adminNewBal" class="input-field" placeholder="Новый баланс" style="margin:0;">
                <button class="btn-action" style="background:var(--yellow); color:#000; width:120px;" onclick="adminSetBalance()">Изменить</button>
            </div>
        </div>

        <div class="profile-card">
            <h3 style="color:#fff; font-size:14px;">📋 Логи и действия игроков</h3>
            <div class="admin-log" id="adminLogs">
                [17:00] Игрок west зашел в систему.<br>
                [17:01] Создан сеанс игры Crash.<br>
            </div>
        </div>
    </div>

    <nav>
        <button class="nav-item active" onclick="switchTab('lobby', this)">
            <span class="nav-icon">🏠</span>
            <span class="nav-label">Лобби</span>
        </button>
        <button class="nav-item" onclick="switchTab('profile', this)">
            <span class="nav-icon">👤</span>
            <span class="nav-label">Профиль</span>
        </button>
    </nav>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.headerColor = '#131822';

        let balance = 1000;
        let currentBet = 10;
        let gameState = 'waiting';
        let multiplier = 1.00;
        let crashPoint = 1.00;
        let gameTimer = null;

        const balanceDisplay = document.getElementById('balance');
        const profileBalance = document.getElementById('profileBalance');
        const adminUserBal = document.getElementById('adminUserBal');
        const currentBetDisplay = document.getElementById('currentBetDisplay');
        const multText = document.getElementById('multText');
        const actionBtn = document.getElementById('actionBtn');
        const historyList = document.getElementById('historyList');
        const adminLogs = document.getElementById('adminLogs');

        function updateUI() {
            balanceDisplay.innerText = balance;
            profileBalance.innerText = balance;
            adminUserBal.innerText = balance;
            currentBetDisplay.innerText = currentBet;
        }

        function addLog(text) {
            let time = new Date().toLocaleTimeString();
            adminLogs.innerHTML += `[${time}] ${text}<br>`;
            adminLogs.scrollTop = adminLogs.scrollHeight;
        }

        function switchTab(tabName, btn) {
            document.querySelectorAll('.main-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            
            if (tabName === 'game') {
                document.getElementById('tab-game').classList.add('active');
            } else if (tabName === 'admin') {
                document.getElementById('tab-admin').classList.add('active');
            } else {
                document.getElementById('tab-' + tabName).classList.add('active');
                if(btn) btn.classList.add('active');
            }
        }

        function openGame(type) {
            if (type === 'crash') {
                switchTab('game');
            } else {
                alert("Игра в разработке, скоро запустим! Запускай Краш ракета 🚀");
                switchTab('game');
            }
        }

        function adjustBet(amount) {
            if (gameState !== 'waiting') return;
            if (amount === 'MAX') {
                currentBet = balance;
            } else {
                currentBet = Math.max(10, currentBet + amount);
                if (currentBet > balance) currentBet = balance;
            }
            updateUI();
        }

        function handleAction() {
            if (gameState === 'waiting') {
                if (currentBet > balance) {
                    alert('Недостаточно средств!');
                    switchTab('profile', document.querySelectorAll('.nav-item')[1]);
                    return;
                }
                balance -= currentBet;
                updateUI();
                addLog(`Игрок поставил ⭐ ${currentBet} в Краш.`);
                startFlight();
            } else if (gameState === 'playing') {
                cashOut();
            }
        }

        function startFlight() {
            gameState = 'playing';
            multiplier = 1.00;
            multText.classList.remove('crashed');
            multText.innerText = '1.00x';
            actionBtn.innerText = 'ЗАБРАТЬ ⭐ ' + Math.floor(currentBet * multiplier);
            actionBtn.className = 'main-action-btn btn-cashout';

            crashPoint = (Math.random() * Math.random() * 4 + 1.1).toFixed(2);

            gameTimer = setInterval(() => {
                multiplier += 0.01 + (multiplier * 0.005);
                multText.innerText = multiplier.toFixed(2) + 'x';
                let winSum = Math.floor(currentBet * multiplier);
                actionBtn.innerText = 'ЗАБРАТЬ ⭐ ' + winSum;

                if (multiplier >= crashPoint) {
                    crashGame();
                }
            }, 100);
        }

        function cashOut() {
            if (gameState !== 'playing') return;
            clearInterval(gameTimer);
            let win = Math.floor(currentBet * multiplier);
            balance += win;
            updateUI();

            gameState = 'crashed';
            multText.innerText = multiplier.toFixed(2) + 'x';
            actionBtn.innerText = `Выиграно ⭐ ${win}`;
            actionBtn.className = 'main-action-btn btn-bet';
            actionBtn.disabled = true;

            addLog(`Игрок успешно забрал ⭐ ${win} на коэффициенте ${multiplier.toFixed(2)}x`);
            addToHistory(multiplier.toFixed(2));
            setTimeout(resetGame, 3000);
        }

        function crashGame() {
            clearInterval(gameTimer);
            gameState = 'crashed';
            multText.classList.add('crashed');
            multText.innerText = crashPoint + 'x';
            actionBtn.innerText = 'Краш! Ставка сгорела';
            actionBtn.className = 'main-action-btn btn-bet';
            actionBtn.disabled = true;

            addLog(`Раунд закрашился на ${crashPoint}x. Ставка проиграна.`);
            addToHistory(crashPoint);
            setTimeout(resetGame, 3000);
        }

        function resetGame() {
            gameState = 'waiting';
            multText.classList.remove('crashed');
            multText.innerText = '1.00x';
            actionBtn.innerText = 'Сделать ставку';
            actionBtn.className = 'main-action-btn btn-bet';
            actionBtn.disabled = false;
        }

        function addToHistory(val) {
            const item = document.createElement('div');
            item.className = 'hist-item ' + (val < 2 ? 'hist-red' : 'hist-green');
            item.innerText = val + 'x';
            historyList.prepend(item);
            if (historyList.children.length > 8) historyList.lastChild.remove();
        }

        function makeDeposit() {
            let sum = parseInt(document.getElementById('depositInput').value) || 0;
            if (sum <= 0) { alert('Введите сумму'); return; }
            balance += sum;
            updateUI();
            addLog(`Успешное пополнение баланса на ⭐ ${sum}`);
            alert(`Баланс пополнен на ${sum} ⭐`);
        }

        function makeWithdraw() {
            let card = document.getElementById('cardNumber').value;
            let sum = parseInt(document.getElementById('withdrawInput').value) || 0;
            if (!card || card.length < 15) { alert('Введите номер карты'); return; }
            if (sum <= 0 || sum > balance) { alert('Неверная сумма для вывода'); return; }
            
            balance -= sum;
            updateUI();
            addLog(`Запрос на вывод ⭐ ${sum} на карту ${card.slice(-4)}`);
            alert(`Заявка на вывод ${sum} ⭐ принята в обработку!`);
        }

        function openAdminPanel() {
            let pass = prompt("Введите пароль администратора:");
            if (pass === "2012") {
                switchTab('admin');
                addLog("Администратор вошел в панель управления.");
            } else if (pass !== null) {
                alert("Неверный пароль!");
                addLog("Неудачная попытка входа в админку.");
            }
        }

        function adminSetBalance() {
            let newBal = parseInt(document.getElementById('adminNewBal').value);
            if (isNaN(newBal)) { alert('Введите число'); return; }
            balance = newBal;
            updateUI();
            addLog(`Админ изменил баланс пользователя на ⭐ ${balance}`);
            alert(`Баланс игрока успешно изменен на ${balance} ⭐`);
        }

        updateUI();
        addToHistory(1.74); addToHistory(2.10);
    </script>
</body>
</html>
