<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Crash Stars Pro</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --text-color: #e6edf3;
            --text-muted: #8b949e;
            --accent: #2ecc71;
            --danger: #e74c3c;
            --border: #30363d;
            --yellow: #f1c40f;
            --blue: #3498db;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); height: 100vh; display: flex; flex-direction: column; overflow: hidden; font-size: 14px; }

        /* Шапка */
        header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background-color: var(--card-bg); border-bottom: 1px solid var(--border); }
        .back-btn { background: none; border: none; color: var(--text-color); font-size: 18px; display: flex; align-items: center; gap: 5px; cursor: pointer; }
        .stars-balance { background: rgba(241, 196, 15, 0.15); color: var(--yellow); padding: 6px 14px; border-radius: 20px; font-weight: bold; display: flex; align-items: center; gap: 6px; cursor: pointer; transition: transform 0.1s; }
        .stars-balance:active { transform: scale(0.95); }

        /* Игровое поле */
        .game-area { flex: 1; position: relative; background: radial-gradient(circle at center, #1a2332 0%, #0d1117 70%); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; }
        .multiplier { font-size: 64px; font-weight: 800; color: #fff; text-shadow: 0 0 15px rgba(255,255,255,0.5); z-index: 10; transition: color 0.2s; }
        .multiplier.crashed { color: var(--danger); }
        .rocket { width: 140px; position: absolute; bottom: 20%; left: 50%; transform: translateX(-50%); transition: transform 0.1s linear, bottom 0.1s linear; z-index: 5; }
        
        /* История */
        .history { display: flex; gap: 8px; padding: 10px 16px; overflow-x: auto; background-color: rgba(0,0,0,0.2); border-bottom: 1px solid var(--border); }
        .hist-item { padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; white-space: nowrap; }
        .hist-green { background: rgba(46, 204, 113, 0.15); color: #2ecc71; }
        .hist-red { background: rgba(231, 76, 60, 0.15); color: #e74c3c; }
        .hist-blue { background: rgba(52, 152, 219, 0.15); color: #3498db; }

        /* Панель ставок */
        .bet-panel { background-color: var(--card-bg); border-top: 1px solid var(--border); padding: 16px; }
        .bet-label { color: var(--text-muted); text-align: center; margin-bottom: 8px; font-size: 13px; }
        .bet-amount { font-size: 32px; font-weight: bold; text-align: center; color: #fff; margin-bottom: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .bet-input-group { display: flex; gap: 8px; margin-bottom: 12px; }
        .bet-btn-small { flex: 1; background-color: #21262d; border: 1px solid var(--border); color: var(--text-color); padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; }
        .main-action-btn { width: 100%; padding: 16px; border-radius: 12px; border: none; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.2s; }
        .btn-bet { background-color: var(--accent); color: #000; }
        .btn-bet:active { background-color: #27ae60; }
        .btn-cashout { background-color: var(--danger); color: #fff; }

        /* Список игроков */
        .players-section { background-color: var(--card-bg); border-top: 1px solid var(--border); flex: 1; overflow-y: auto; }
        .players-header { padding: 12px 16px; color: var(--text-muted); font-size: 13px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; }
        .player-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-bottom: 1px solid rgba(48, 54, 61, 0.5); }
        .player-info { display: flex; align-items: center; gap: 10px; }
        .player-avatar { width: 32px; height: 32px; border-radius: 50%; background-color: #30363d; display: flex; align-items: center; justify-content: center; font-size: 16px; }
        .player-name { font-weight: 500; color: var(--text-color); }
        .player-bet-info { color: var(--text-muted); font-size: 12px; }
        .player-winnings { font-weight: bold; color: var(--accent); }
        .player-status-lost { color: var(--danger); font-weight: bold; }

        /* Нижнее меню */
        nav { display: flex; background-color: var(--card-bg); border-top: 1px solid var(--border); padding-bottom: env(safe-area-inset-bottom); }
        .nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px; color: var(--text-muted); background: none; border: none; cursor: pointer; gap: 4px; }
        .nav-item.active { color: var(--accent); }
        .nav-icon { font-size: 20px; }
        .nav-label { font-size: 11px; font-weight: 500; }

        /* Модальное окно пополнения */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.75); display: none; justify-content: center; align-items: flex-end; z-index: 100; backdrop-filter: blur(4px); }
        .modal-content { background: var(--card-bg); width: 100%; border-radius: 20px 20px 0 0; padding: 20px; border-top: 1px solid var(--border); max-height: 80vh; overflow-y: auto; animation: slideUp 0.2s ease-out; }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .modal-title { font-size: 18px; font-weight: bold; color: #fff; }
        .close-btn { background: none; border: none; color: var(--text-muted); font-size: 22px; cursor: pointer; }
        
        .deposit-methods { display: flex; flex-direction: column; gap: 12px; }
        .deposit-card { background: #21262d; border: 1px solid var(--border); border-radius: 14px; padding: 16px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: border-color 0.2s; }
        .deposit-card:active { border-color: var(--accent); background: #282e36; }
        .deposit-info { display: flex; align-items: center; gap: 14px; }
        .deposit-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
        .icon-stars { background: rgba(241, 196, 15, 0.2); }
        .icon-crypto { background: rgba(52, 152, 219, 0.2); }
        .icon-card { background: rgba(46, 204, 113, 0.2); }
        .deposit-name { font-weight: bold; color: #fff; font-size: 15px; }
        .deposit-desc { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
        .arrow-icon { color: var(--text-muted); font-weight: bold; }
    </style>
</head>
<body>
    <header>
        <button class="back-btn">← Назад</button>
        <div class="stars-balance" onclick="openDepositModal()">⭐ <span id="balance">1000</span> +</div>
    </header>

    <div id="tab-game" class="main-content" style="display: flex; flex-direction: column; flex: 1; overflow: hidden;">
        <div class="history" id="historyList"></div>

        <div class="game-area">
            <div class="multiplier" id="multText">1.00x</div>
            <img src="https://cdni.iconscout.com/illustration/premium/thumb/rocket-launch-investment-4019230-3335277.png" alt="Rocket" class="rocket" id="rocketImg">
        </div>

        <div class="bet-panel">
            <p class="bet-label">Введите сумму ставки</p>
            <div class="bet-amount">⭐ <span id="currentBetDisplay">10</span></div>
            <div class="bet-input-group">
                <button class="bet-btn-small" onclick="adjustBet(-10)">-10</button>
                <button class="bet-btn-small" onclick="adjustBet(50)">+50</button>
                <button class="bet-btn-small" onclick="adjustBet('MAX')">MAX</button>
            </div>
            <button id="actionBtn" class="main-action-btn btn-bet" onclick="handleAction()">★ Сделать ставку</button>
        </div>

        <div class="players-section">
            <div class="players-header">
                <span>Список участников</span>
                <span style="color: var(--accent);">● Игра идет</span>
            </div>
            <div id="playersList">
                <div class="player-row">
                    <div class="player-info">
                        <div class="player-avatar">👤</div>
                        <div>
                            <div class="player-name">rok233 (Вы)</div>
                            <div class="player-bet-info">⭐ 10 | Авто: Нет</div>
                        </div>
                    </div>
                    <div class="player-status-lost" id="myStatus">В игре</div>
                </div>
                <div class="player-row">
                    <div class="player-info">
                        <div class="player-avatar">👻</div>
                        <div>
                            <div class="player-name">Vadim</div>
                            <div class="player-bet-info">⭐ 50 | Авто: 2.0x</div>
                        </div>
                    </div>
                    <div class="player-winnings">⭐ 100 (2.0x)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Заглушки для других вкладок -->
    <div id="tab-cases" class="main-content" style="display:none; flex:1; justify-content:center; align-items:center; color:var(--text-muted);">Раздел Кейсы в разработке</div>
    <div id="tab-leaders" class="main-content" style="display:none; flex:1; justify-content:center; align-items:center; color:var(--text-muted);">Раздел Лидеры в разработке</div>
    <div id="tab-profile" class="main-content" style="display:none; flex:1; flex-direction:column; padding:20px; gap:12px;">
        <h2 style="color:#fff;">Ваш профиль</h2>
        <p style="color:var(--text-muted);">ID: <span id="userId">---</span></p>
        <button class="main-action-btn btn-bet" onclick="openDepositModal()">💰 Пополнить баланс</button>
    </div>

    <nav>
        <button class="nav-item active" onclick="switchTab('game', this)">
            <span class="nav-icon">🏠</span>
            <span class="nav-label">Главная</span>
        </button>
        <button class="nav-item" onclick="switchTab('cases', this)">
            <span class="nav-icon">📦</span>
            <span class="nav-label">Кейсы</span>
        </button>
        <button class="nav-item" onclick="switchTab('leaders', this)">
            <span class="nav-icon">📊</span>
            <span class="nav-label">Лидеры</span>
        </button>
        <button class="nav-item" onclick="switchTab('profile', this)">
            <span class="nav-icon">👤</span>
            <span class="nav-label">Профиль</span>
        </button>
    </nav>

    <!-- МОДАЛЬНОЕ ОКНО ВЫБОРА ОПЛАТЫ -->
    <div class="modal-overlay" id="depositModal">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">Выберите способ пополнения</span>
                <button class="close-btn" onclick="closeDepositModal()">✕</button>
            </div>
            <div class="deposit-methods">
                <div class="deposit-card" onclick="payViaStars()">
                    <div class="deposit-info">
                        <div class="deposit-icon icon-stars">⭐</div>
                        <div>
                            <div class="deposit-name">Telegram Stars</div>
                            <div class="deposit-desc">Оплата встроенными звёздами</div>
                        </div>
                    </div>
                    <span class="arrow-icon">›</span>
                </div>

                <div class="deposit-card" onclick="payViaCrypto()">
                    <div class="deposit-info">
                        <div class="deposit-icon icon-crypto">💎</div>
                        <div>
                            <div class="deposit-name">Криптовалюта (Crypto Pay)</div>
                            <div class="deposit-desc">USDT, TON, BTC, LTC</div>
                        </div>
                    </div>
                    <span class="arrow-icon">›</span>
                </div>

                <div class="deposit-card" onclick="payViaCard()">
                    <div class="deposit-info">
                        <div class="deposit-icon icon-card">💳</div>
                        <div>
                            <div class="deposit-name">Банковская карта / СБП</div>
                            <div class="deposit-desc">Карты РФ, СНГ, СБП</div>
                        </div>
                    </div>
                    <span class="arrow-icon">›</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.headerColor = '#161b22';

        let currentBalance = 1000;
        let currentBet = 10;
        let isGameState = 'waiting';
        let multiplier = 1.00;
        let gameTimer = null;
        let crashPoint = 0;

        const multText = document.getElementById('multText');
        const actionBtn = document.getElementById('actionBtn');
        const rocketImg = document.getElementById('rocketImg');
        const balanceDisplay = document.getElementById('balance');
        const betDisplay = document.getElementById('currentBetDisplay');
        const historyList = document.getElementById('historyList');
        const myStatus = document.getElementById('myStatus');

        function updateUI() {
            balanceDisplay.innerText = currentBalance;
            betDisplay.innerText = currentBet;
        }

        function openDepositModal() { document.getElementById('depositModal').style.display = 'flex'; }
        function closeDepositModal() { document.getElementById('depositModal').style.display = 'none'; }

        function payViaStars() {
            closeDepositModal();
            tg.sendData(JSON.stringify({ action: "deposit", method: "stars" }));
            alert("Запрос на пополнение Telegram Stars отправлен в бота!");
        }

        function payViaCrypto() {
            closeDepositModal();
            tg.sendData(JSON.stringify({ action: "deposit", method: "crypto" }));
            alert("Для оплаты криптовалютой откроется CryptoBot!");
        }

        function payViaCard() {
            closeDepositModal();
            tg.sendData(JSON.stringify({ action: "deposit", method: "card" }));
            alert("Переход к оплате картой...");
        }

        function adjustBet(amount) {
            if (isGameState !== 'waiting') return;
            if (amount === 'MAX') {
                currentBet = currentBalance;
            } else {
                currentBet = Math.max(10, currentBet + amount);
                if (currentBet > currentBalance) currentBet = currentBalance;
            }
            updateUI();
        }

        function handleAction() {
            if (isGameState === 'waiting') {
                if (currentBet > currentBalance) { openDepositModal(); return; }
                currentBalance -= currentBet;
                updateUI();
                startGame();
            } else if (isGameState === 'playing') {
                cashOut();
            }
        }

        function startGame() {
            isGameState = 'playing';
            multiplier = 1.00;
            multText.classList.remove('crashed');
            multText.innerText = '1.00x';
            actionBtn.innerText = '✕ ЗАБРАТЬ ⭐ ' + (currentBet * multiplier).toFixed(2);
            actionBtn.className = 'main-action-btn btn-cashout';
            myStatus.innerText = 'В игре';
            myStatus.className = 'player-status-lost';
            rocketImg.style.transform = 'translateX(-50%) translateY(0)';
            
            crashPoint = (Math.random() * Math.random() * 5 + 1.05).toFixed(2);
            
            clearInterval(gameTimer);
            gameTimer = setInterval(() => {
                multiplier += 0.01 + (multiplier * 0.005);
                multText.innerText = multiplier.toFixed(2) + 'x';
                
                let height = Math.min(60, 20 + (multiplier - 1) * 10);
                rocketImg.style.bottom = height + '%';
                
                if (isGameState === 'playing') {
                    actionBtn.innerText = '✕ ЗАБРАТЬ ⭐ ' + (currentBet * multiplier).toFixed(2);
                }

                if (multiplier >= crashPoint) {
                    endGame(false);
                }
            }, 100);
        }

        function cashOut() {
            if (isGameState !== 'playing') return;
            isGameState = 'waiting';
            let winnings = Math.floor(currentBet * multiplier);
            currentBalance += winnings;
            updateUI();
            actionBtn.innerText = 'Ожидание следующего раунда...';
            actionBtn.className = 'main-action-btn btn-bet';
            actionBtn.disabled = true;
            myStatus.innerText = '⭐ ' + winnings + ' (' + multiplier.toFixed(2) + 'x)';
            myStatus.className = 'player-winnings';
        }

        function endGame(winned) {
            clearInterval(gameTimer);
            isGameState = 'crashed';
            multText.innerText = crashPoint + 'x';
            multText.classList.add('crashed');
            rocketImg.style.transform = 'translateX(-50%) scale(1.2)';
            
            if (myStatus.innerText === 'В игре') {
                myStatus.innerText = 'Проиграл';
                myStatus.className = 'player-status-lost';
            }

            addToHistory(crashPoint);

            setTimeout(() => {
                isGameState = 'waiting';
                actionBtn.innerText = '★ Сделать ставку';
                actionBtn.className = 'main-action-btn btn-bet';
                actionBtn.disabled = false;
                myStatus.innerText = 'Готов';
                multText.classList.remove('crashed');
                multText.innerText = 'Готовность';
                rocketImg.style.bottom = '20%';
                rocketImg.style.transform = 'translateX(-50%) translateY(0)';
            }, 3000);
        }

        function addToHistory(value) {
            const item = document.createElement('div');
            item.className = 'hist-item';
            if (value < 1.5) item.classList.add('hist-red');
            else if (value < 2.5) item.classList.add('hist-blue');
            else item.classList.add('hist-green');
            item.innerText = value + 'x';
            historyList.prepend(item);
            if (historyList.children.length > 10) historyList.lastChild.remove();
        }

        function switchTab(tabName, btn) {
            document.querySelectorAll('.main-content').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            document.getElementById('tab-' + tabName).style.display = 'flex';
            btn.classList.add('active');
        }

        updateUI();
        multText.innerText = 'Ожидание...';
        addToHistory(1.74); addToHistory(1.98); addToHistory(1.07);
    </script>
</body>
</html>
